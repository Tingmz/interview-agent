# ============================================================
# 这个文件存放密钥，已被 .gitignore 排除，不会被提交
# ============================================================

# ---- DeepSeek（必填：把 key 粘贴到等号右边，不要加引号）----
DEEPSEEK_API_KEY=粘贴您的 DeepSeek API Key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# LLM_MODE: auto=联网+磁盘缓存(默认) / mock=不联网不花钱 / replay=只回放缓存绝不联网
LLM_MODE=auto

# ---- 成本护栏 ----
# 单任务累计 token 估算上限，超过直接报错停下，防意外爆量
LLM_TOKEN_BUDGET=200000
# 单价（元/百万 token）。默认值是**保守上限**，请以 DeepSeek 官网定价为准自行调整
LLM_PRICE_IN=2.0
LLM_PRICE_OUT=8.0

# ---- 飞书（阶段六使用，现在先留空）----
FEISHU_APP_ID=粘贴您的 飞书 App ID
FEISHU_APP_SECRET=粘贴您的 飞书 App Secret
